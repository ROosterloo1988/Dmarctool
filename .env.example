# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me

# --- Microsoft Graph app registration (see docs/app-registratie.md) ---
DMARC_GRAPH_TENANT_ID=
DMARC_GRAPH_CLIENT_ID=
# Preferred: certificate (PEM with private key + certificate) in ./secrets/
DMARC_GRAPH_CERTIFICATE_PATH=/run/secrets/dmarc/graph-cert.pem
# DMARC_GRAPH_CERTIFICATE_PASSWORD=
# Alternative: client secret (leave CERTIFICATE_PATH empty then)
# DMARC_GRAPH_CLIENT_SECRET=

# --- Mailbox defaults; can be changed at runtime (dmarc settings / management UI) ---
# DMARC_MAILBOX_ADDRESS=dmarc@tenazenergy.com
# DMARC_MAILBOX_SOURCE_FOLDER=Inbox
# DMARC_MAILBOX_PROCESSED_FOLDER=Verwerkt
# DMARC_MAILBOX_FAILED_FOLDER=Fout
# DMARC_MAILBOX_POLL_MINUTES=15
# DMARC_MAILBOX_BATCH_SIZE=200

# --- Backups ---
# BACKUP_DIR=./backups
# BACKUP_HOUR_UTC=2
# BACKUP_KEEP_DAYS=14
# DMARC_PURGE_HOUR_UTC=3

# --- Safety limits (defaults shown) ---
# DMARC_MAX_MESSAGE_BYTES=52428800
# DMARC_MAX_ATTACHMENT_BYTES=26214400
# DMARC_MAX_UNCOMPRESSED_BYTES=104857600
# DMARC_MAX_TOTAL_UNCOMPRESSED_BYTES=209715200
# DMARC_MAX_ARCHIVE_MEMBERS=50
# DMARC_MAX_COMPRESSION_RATIO=200
# DMARC_MAX_NESTING_DEPTH=2

# --- Forensic (RUF) privacy ---
# DMARC_RUF_STORE_BODY=false
# DMARC_RUF_RETENTION_DAYS=30

# --- Aggregate (RUA) retention ---
# DMARC_RUA_STORE_RAW_XML=true
# DMARC_RUA_RETENTION_DAYS=730
