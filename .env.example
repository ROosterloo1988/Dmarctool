# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me

# --- Microsoft Graph app registration (see docs/app-registratie.md) ---
DMARC_GRAPH_TENANT_ID=
DMARC_GRAPH_CLIENT_ID=
# Preferred: certificate (PEM with private key + certificate) in ./secrets/
DMARC_GRAPH_CERTIFICATE_PATH=/run/secrets/dmarc/graph-cert.pem
# DMARC_GRAPH_CERTIFICATE_PASSWORD=
# Alternative: client secret (leave CERTIFICATE_PATH empty then)
# DMARC_GRAPH_CLIENT_SECRET=

# --- Web UI / sign-in (see docs/app-registratie.md section 2) ---
# Random value, at least 32 characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DMARC_SECRET_KEY=
DMARC_PUBLIC_URL=https://dmarcportal.tenazenergy.com
DMARC_OIDC_CLIENT_ID=
DMARC_OIDC_CLIENT_SECRET=
# DMARC_OIDC_TENANT_ID=            # defaults to DMARC_GRAPH_TENANT_ID
# DMARC_OIDC_ADMIN_ROLE=DMARC.Admin
# DMARC_OIDC_VIEWER_ROLE=DMARC.Viewer
# DMARC_SESSION_HOURS=8
# Emergency local accounts (create with: docker compose run --rm cli user add <name>)
DMARC_LOCAL_LOGIN_ENABLED=false
# Subnet of the Azure Application Gateway (trusted for X-Forwarded-For/Proto)
FORWARDED_ALLOW_IPS=10.0.0.0/24
# Only for testing over plain http on localhost:
# DMARC_COOKIE_SECURE=false

# --- Mailbox defaults; can be changed at runtime (dmarc settings / management UI) ---
# DMARC_MAILBOX_ADDRESS=dmarc@tenazenergy.com
# DMARC_MAILBOX_SOURCE_FOLDER=Inbox
# DMARC_MAILBOX_PROCESSED_FOLDER=Verwerkt
# DMARC_MAILBOX_FAILED_FOLDER=Fout
# DMARC_MAILBOX_POLL_MINUTES=15
# DMARC_MAILBOX_BATCH_SIZE=200

# --- Notifications: defaults only; normally set in the UI (Settings > Notifications) ---
# DMARC_NOTIFY_RECIPIENTS=["it@tenazenergy.com"]
# DMARC_NOTIFY_DIGEST_HOUR_UTC=6
# DMARC_NOTIFY_NEW_SOURCE_MIN_MESSAGES=50
# DMARC_NOTIFY_PASS_DROP_POINTS=5

# --- Backups ---
# BACKUP_DIR=./backups
# BACKUP_HOUR_UTC=2
# BACKUP_KEEP_DAYS=14
# DMARC_PURGE_HOUR_UTC=3

# --- Safety limits (defaults shown) ---
# DMARC_MAX_MESSAGE_BYTES=52428800
# DMARC_MAX_ATTACHMENT_BYTES=26214400
# DMARC_MAX_UNCOMPRESSED_BYTES=104857600
# DMARC_MAX_TOTAL_UNCOMPRESSED_BYTES=209715200
# DMARC_MAX_ARCHIVE_MEMBERS=50
# DMARC_MAX_COMPRESSION_RATIO=200
# DMARC_MAX_NESTING_DEPTH=2

# --- Forensic (RUF) privacy ---
# Store the body of the reported message (personal data; deleted after the retention period)
# DMARC_RUF_STORE_BODY=true
# DMARC_RUF_RETENTION_DAYS=30

# --- Aggregate (RUA) retention ---
# DMARC_RUA_STORE_RAW_XML=true
# DMARC_RUA_RETENTION_DAYS=730
