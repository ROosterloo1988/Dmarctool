# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me

# --- Safety limits (defaults shown) ---
# DMARC_MAX_MESSAGE_BYTES=52428800
# DMARC_MAX_ATTACHMENT_BYTES=26214400
